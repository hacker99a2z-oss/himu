{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "./dist",
    "noEmit": false,
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "noEmitOnError": true
  },
  "include": ["./src/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../frontend"]
}
